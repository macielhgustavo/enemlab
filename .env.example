# Sincronização na nuvem (opcional). Sem estas variáveis o app funciona
# normalmente em modo local: a aba Conta apenas informa que a nuvem está
# desligada.
#
# Estes valores são públicos por design — a chave publishable vai no bundle
# do navegador. Quem protege os dados é o RLS: aplique supabase/schema.sql
# e siga supabase/VERIFICAR-RLS.md antes de confiar na sincronização.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE

# Student AI. O mock determinístico é o padrão e não exige chave externa.
ENEMLAB_AI_PROVIDER=mock

# Provider genérico compatível com a API Chat Completions.
# ENEMLAB_AI_PROVIDER=openai-compatible
# ENEMLAB_AI_API_KEY=
# ENEMLAB_AI_MODEL=
# ENEMLAB_AI_BASE_URL=https://api.openai.com/v1

# Contingência do Student AI:
# - development/test: fallback para mock é ligado por padrão;
# - production: fallback é desligado por padrão (fail closed).
# Defina explicitamente true/false para sobrescrever esse comportamento.
# ENEMLAB_AI_FALLBACK_TO_MOCK=false
