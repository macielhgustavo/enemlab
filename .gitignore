# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# O exemplo deve ser versionado: documenta as variáveis sem trazer valores.
!.env.example

# Python (script de ingestão)
__pycache__/
*.py[cod]

# Local ingestion checkpoints and generated media candidates
/.ingestion-cache/
/.ingestion-media/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Storybook
/storybook-static/
# Local document verification cache
/ui-review/
/ui-review-results.json
/test-results-refinement/
/.cache/
