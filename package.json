{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run && python -m unittest discover -s scripts/tests -p test_*.py",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e:ci": "playwright test e2e/smoke.spec.ts e2e/a11y.spec.ts",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "ingest": "node scripts/ingest.mjs",
    "ingest:source": "tsc -p tsconfig.ingest-cli.json && node .cache/ingest-cli/scripts/ingest-source.js",
    "harvest:brasil-escola": "python scripts/harvest-brasil-escola.py",
    "harvest:uece": "python scripts/harvest-uece-brasil-escola.py",
    "ingest:inbox": "python scripts/ingest-inbox.py",
    "ingest:uece": "python scripts/ingest-uece-safe.py",
    "ingest:fab": "python scripts/ingest-fab.py",
    "ingest:fuvest": "python scripts/ingest-fuvest.py",
    "ingest:fuvest:questions": "python scripts/extract-fuvest-questions.py",
    "ingest:fuvest:ocr": "python scripts/recover-fuvest-ocr.py",
    "ingest:fuvest:region-ocr": "python scripts/recover-fuvest-region-ocr.py",
    "ingest:fuvest:media": "python scripts/extract-fuvest-media.py",
    "ingest:fuvest:semantic": "python scripts/refine-fuvest-semantic.py",
    "ingest:fuvest:batch": "python scripts/fuvest-batch-lab.py",
    "ingest:vestibular": "python scripts/ingest_vestibular_reference.py",
    "sources:audit": "node --use-system-ca scripts/sources-audit.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "storybook": "^10.6.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}