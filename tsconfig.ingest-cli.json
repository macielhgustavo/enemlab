{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": ".cache/ingest-cli",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "incremental": false,
    "types": ["node"]
  },
  "include": ["scripts/ingest-source.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
